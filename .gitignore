# Public repository: deny by default. Keep private working files on this Mac.
/*
!/.gitignore
!/.gitattributes
!/.nvmrc
!/.env.example
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/index.html
!/wrangler.jsonc

# Runtime source and language resources only.
!/src/
/src/**
!/src/**/
!/src/**/*.ts
!/src/**/*.tsx
!/src/**/*.css
!/src/i18n/en.json
!/contracts/
/contracts/*
!/contracts/Pinhaotuan.sol
!/contracts/DemoUSD.sol
!/contracts/TestUSDC.sol
!/worker/
/worker/*
!/worker/index.ts
!/worker/media.ts

# Only reusable engineering entrypoints; no recording, TTS or export scripts.
!/scripts/
/scripts/*
!/scripts/compile-contracts.mjs
!/scripts/deploy-local.mjs
!/scripts/test-contracts.mjs
!/scripts/test-recovery-unit.mjs
!/scripts/test-controller-regressions.mjs
!/scripts/test-media-worker.mjs
!/scripts/check-repository.mjs

# Public configuration and compact chain evidence, not demo-production files.
!/public/
/public/*
!/public/_headers
!/public/deployment.json
!/public/catalog.json
!/public/proof/
/public/proof/*
!/public/proof/settlement.json
!/public/proof/README.md

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

# Defense in depth, including inside otherwise allowed source directories.
**/node_modules/
**/dist/
**/artifacts/
**/.hunter/
**/.wrangler/
**/__pycache__/
**/.DS_Store
**/AGENTS.md
**/CLAUDE.md
*.tsbuildinfo
*.log
*.pem
*.key
*.p12
*.pfx
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.aiff
*.pptx
*.pdf
*.docx
*.zip
*.tgz
*.ttf
*.otf
*.woff
*.woff2
.env
.env.*
!/.env.example
